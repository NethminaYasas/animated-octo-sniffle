# kaluwo environment template
# Copy this file to .env.local and fill in your own values.
# Never commit .env.local or any real secret.

# ---------------------------------------------------------------------------
# Supabase — Project Settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used to map a username to its email for username login.
# Never prefix with NEXT_PUBLIC_ and never import it in a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (CAPTCHA) — public site key
# ---------------------------------------------------------------------------
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile and
# add localhost (and your production domain) to its hostnames.
# The app verifies Turnstile itself, so leave Supabase's built-in CAPTCHA off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only secret key. Never prefix with NEXT_PUBLIC_.
TURNSTILE_SECRET_KEY=

# Cloudflare's local-development test keys (always pass):
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ---------------------------------------------------------------------------
# Media uploads (later steps) — leave commented out for now
# ---------------------------------------------------------------------------

# Catbox account userhash. Server-side only. Never prefix with NEXT_PUBLIC_.
# CATBOX_USERHASH=

# Per-file media limits in megabytes (defaults shown).
# MEDIA_MAX_IMAGE_MB=10
# MEDIA_MAX_AUDIO_MB=30
# MEDIA_MAX_VIDEO_MB=100
