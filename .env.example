# kaluwo environment template
# Copy this file to .env.local and fill in your own values.
# Never commit .env.local or any real secret.

# ---------------------------------------------------------------------------
# Supabase — Project Settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used for username login, invite-code sign-up and Google
# onboarding. Never prefix with NEXT_PUBLIC_ and never import it in a Client
# Component.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (CAPTCHA) — public site key
# ---------------------------------------------------------------------------
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile and
# add localhost (and your production domain) to its hostnames.
# The app verifies Turnstile itself, so leave Supabase's built-in CAPTCHA off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only secret key. Never prefix with NEXT_PUBLIC_.
TURNSTILE_SECRET_KEY=

# Cloudflare's local-development test keys (always pass):
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ---------------------------------------------------------------------------
# Media uploads (Phase 3) — server-only, leave commented out for local dev
# ---------------------------------------------------------------------------

# Catbox account userhash. Optional but recommended: without it the app can
# hide an upload in the forum but cannot delete the file at catbox (anonymous
# files rely on catbox's 2-year inactivity purge). Server-side only. Never
# prefix with NEXT_PUBLIC_. Get it from your catbox profile.
# CATBOX_USERHASH=

# Catbox API endpoint. Defaults to https://catbox.moe/user/api.php. Only set
# this to point the app at a local fake provider in tests; it is server-side
# only. Never prefix with NEXT_PUBLIC_.
# CATBOX_API_ENDPOINT=

# Per-file media limits in megabytes (defaults shown). The video cap is 50 MB,
# matching Cloudflare's proxy request body guidance for self-hosted origins;
# raise it only if the proxy allows more.
# MEDIA_MAX_IMAGE_MB=10
# MEDIA_MAX_AUDIO_MB=30
# MEDIA_MAX_VIDEO_MB=50
